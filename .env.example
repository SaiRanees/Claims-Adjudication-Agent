# Local development settings. The dev tool (go run ./cmd/dev) copies this file to .env
# on first use, and Docker Compose reads .env automatically.
#
# These values are for local development only. Use letters, digits and hyphens
# in passwords: they go into connection URLs without escaping.

# Postgres superuser. Used only on first start, to create the roles and database.
POSTGRES_PASSWORD=postgres-dev-only

# Owns the schema. Migrations and the seed run as this role.
CLAIMS_OWNER_PASSWORD=owner-dev-only

# The api, relay and worker connect as this role. It has only what migrations grant.
CLAIMS_APP_PASSWORD=app-dev-only

# SeaweedFS S3 credentials, and the bucket for claim documents (created on start).
S3_ACCESS_KEY=claims-dev
S3_SECRET_KEY=claims-dev-secret-change-me
S3_BUCKET=claim-documents

# Signs and checks the API's bearer tokens (HS256): at least 32 bytes.
# `go run ./cmd/dev token` prints a token signed with it, for calling the API locally.
AUTH_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789

# From week 3: model provider keys. Never commit a real key.
# ANTHROPIC_API_KEY=
